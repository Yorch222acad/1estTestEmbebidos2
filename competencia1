def detect_blue_color():
    """
    Detecta color azul usando la cámara y devuelve True si encuentra azul significativo
    
    Returns:
        bool: True si detecta color azul, False en caso contrario
    """
    global cap
    
    if cap is None:
        try:
            cap = cv2.VideoCapture(0)  # Inicializar cámara
            if not cap.isOpened():
                return False
        except:
            return False
    
    ret, frame = cap.read()
    if not ret:
        return False
    
    # Convertir BGR a HSV para mejor detección de color
    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    
    # Definir rango de color azul en HSV
    # Azul tiene un rango de matiz (Hue) alrededor de 100-130
    lower_blue = np.array([100, 50, 50])   # Límite inferior HSV para azul
    upper_blue = np.array([130, 255, 255]) # Límite superior HSV para azul
    
    # Crear máscara para el color azul
    mask_blue = cv2.inRange(hsv, lower_blue, upper_blue)
    
    # Contar píxeles azules
    blue_pixels = cv2.countNonZero(mask_blue)
    total_pixels = frame.shape[0] * frame.shape[1]
    blue_percentage = (blue_pixels / total_pixels) * 100
    
    # Si más del 5% de la imagen es azul, considerarlo como detección
    if blue_percentage > 5.0:
        return True
    
    return False

