#======================================================

def main():
    # Configuración inicial usando diccionario:
    DutyValue = 50
    
    state = {
        'mtr1Stt': True,
        'mtr2Stt': True,
        'AvzStt': False,
        'RtrStt': False,
        'LedStt': False,
        'duty': int((DutyValue / 100) * 65535)
    }

    try:
        while True:
            led0.value(0)
            
            #-----------------------
            state = UartHandler(state)
            #-----------------------
            if state['AvzStt']:
                if state['mtr1Stt']:
                    Pwm1.duty_u16(state['duty'])
                    dir1.value(1)
                    dir2.value(0)
                if state['mtr2Stt']:
                    Pwm2.duty_u16(state['duty'])
                    dir3.value(1)
                    dir4.value(0)
                if interactiveDelay(1):
                        state['AvzStt'] = False
            if state['RtrStt']: 
                if state['mtr1Stt']:
                    Pwm1.duty_u16(state['duty'])
                    dir1.value(0)
                    dir2.value(1)
                if state['mtr2Stt']:
                    Pwm2.duty_u16(state['duty'])
                    dir3.value(0)
                    dir4.value(1)
                if interactiveDelay(1):
                        state['RtrStt'] = False
            if state['AvzStt'] == False and state['RtrStt'] == False:
                    Pwm1.duty_u16(0)
                    dir1.value(0)
                    dir2.value(0)
                    Pwm2.duty_u16(0)
                    dir3.value(0)
                    dir4.value(0)
            if state['LedStt']:
                led4.value(1)
                led3.value(1)
                if interactiveDelay(2):
                    state['LedStt'] = False
            

                
    except Exception as e:
        led0.toggle()
        utime.sleep_ms(200)
        led0.toggle()
        utime.sleep_ms(200)

#======================================================

def interactiveDelay(time_sec):
    global tIter
    if tIter == 0:
        # Guardar el instante de inicio en milisegundos
        tIter = utime.ticks_add(utime.ticks_ms(), int(time_sec * 1000))
    # Verificar si ya pasó el tiempo deseado
    if utime.ticks_diff(tIter, utime.ticks_ms()) <= 0:
        tIter = 0
        return True  # señal de que el tiempo terminó
    return False

