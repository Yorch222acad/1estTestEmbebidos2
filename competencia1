cap = None  # Cámara
blue_detected = False

# Configuraciones de pines:
#-------------------------{ Leds
led0 = machine.Pin("LED", machine.Pin.OUT)  # Configura el Led integrado como salida
led1 = Pin(10, Pin.OUT)  # Actividad Uart
