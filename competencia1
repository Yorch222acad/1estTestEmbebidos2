def UartHandler(state):
    """
    Maneja los comandos UART usando un diccionario de estado.
    
    Args:
        state (dict): Diccionario con claves: 'mtr1Stt', 'mtr2Stt', 'duty', 'AvzStt', 'RtrStt'
    
    Returns:
        dict: Diccionario actualizado con el nuevo estado
    """
    if poll.poll(0):
        led0.value(1)
        linea = sys.stdin.readline().strip()

        # ---- Motor 1 ----
        if linea == "M1":
            led1.toggle()
            state['mtr1Stt'] = not state['mtr1Stt']
            led2.value(state['mtr1Stt'])

        # ---- Motor 2 ----
        elif linea == "M2":
            led1.toggle()
            state['mtr2Stt'] = not state['mtr2Stt']
            led3.value(state['mtr2Stt'])

        # ---- DutyCycle ----
        elif linea.startswith("DC"):
            try:
                # Extraer el valor numérico después de "DC"
                parts = linea.split()
                if len(parts) == 2:
                    DutyValue = int(parts[1])
                    if 0 <= DutyValue <= 100:
                        state['duty'] = int((DutyValue / 100) * 65535)
                        #print("Nuevo DutyCycle:", DutyValue, "%")
                #     else:
                #         print("Valor fuera de rango (0-100)")
                # else:
                #     print("Formato inválido del mensaje:", linea)
            except ValueError:
                print("Error al convertir DutyCycle:", linea)

        # ---- Avanzar ----
        elif linea == "Ad":
            # Activar los motores para avanzar
            led1.toggle()  # Toggle de LED para mostrar que el comando fue recibido
            state['AvzStt'] = True
            state['RtrStt'] = False
            #print("Motores avanzando")

        # ---- Retroceder ----
        elif linea == "At":
            # Activar los motores para retroceder
            led1.toggle()  # Toggle de LED para mostrar que el comando fue recibido
            state['AvzStt'] = False
            state['RtrStt'] = True
            #print("Motores retrocediendo")
        
         # ---- Detener ----
        elif linea == "D":
            # Detener los motores
            led1.toggle()  # Toggle de LED para mostrar que el comando fue recibido
            state['AvzStt'] = False
            state['RtrStt'] = False
            #print("Motores detenidos")
            
        # ---- Control LED (activado por detección de azul) ----
        elif linea == "Led":
            # Activar LED4 cuando se detecta azul
            state['LedStt'] = True
            #print("LED azul activado")

    return state

